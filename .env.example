# Runtime stage and mode
PM_VALIDATION_STAGE=architecture
PM_RUNTIME_MODE=paper

# Storage
PM_DATABASE_PATH=var/pm_bot.sqlite3
PM_ARTIFACT_ROOT=artifacts

# Capital and guardrails
PM_INITIAL_BANKROLL=1000
PM_PROBE_MAX_FRACTION=0.005
PM_PROBE_MAX_NOTIONAL=20
PM_MARKET_MAX_FRACTION=0.015
PM_MARKET_MAX_NOTIONAL=60
PM_DAILY_LOSS_FRACTION=0.02
PM_DAILY_LOSS_NOTIONAL=75

# API endpoints
PM_POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
PM_POLYMARKET_CLOB_URL=https://clob.polymarket.com
PM_REFERENCE_ODDS_URL=https://api.the-odds-api.com/v4

# Explicitly disabled unless later approved
PM_ENABLE_LIVE_SMALL=false

# Reserved for future approved live_small validation only.
# Keep unset during architecture / local_validation / paper_canary.
PM_POLYMARKET_PRIVATE_KEY=
PM_POLYMARKET_API_KEY=
PM_POLYMARKET_API_SECRET=
PM_POLYMARKET_API_PASSPHRASE=
PM_POLYMARKET_FUNDER=
